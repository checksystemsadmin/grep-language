# Copy to a project-local runtime environment file; do not commit secrets.
PENTAGON_RUNTIME_DIR=./runtime
PENTAGON_WAKE_LOCK=0

# Watchdog defaults are compiled into the Kotlin configuration:
# battery warning: 42 C
# battery critical: 48 C
# critical battery percentage: 5
# telemetry freshness: 15000 ms
# consecutive sensor failures: 3

# MRE is a bounded allocated test-buffer reserve, not secure memory.
